# ==========================================
# ECCD Monitoring System - Environment Configuration
# ==========================================

# Flask Secret Key
SECRET_KEY=eccd-super-secret-key-change-this-in-production

# ------------------------------------------
# OPTION 1: TiDB Cloud Serverless (Recommended 100% Free Forever)
# TiDB Cloud gives you 5GB free storage, no credit card required.
# https://tidbcloud.com/
# ------------------------------------------
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_prefix.root
DB_PASSWORD=your_tidb_password
DB_NAME=eccd_db
DB_SSL=true

# ------------------------------------------
# OPTION 2: Single Connection URL (Aiven, Railway, etc.)
# If your free database provider gives a URL:
# ------------------------------------------
# DATABASE_URL=mysql://user:password@host:port/eccd_db?ssl-mode=REQUIRED
